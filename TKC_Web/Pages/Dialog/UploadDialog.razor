<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">

            <MudText Typo="Typo.h6">
                Upload Files
            </MudText>

            <MudPaper Class="pa-4"
                      Outlined="true">

                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                               FilesChanged="UploadFiles"
                               DragAndDrop="true"
                               AppendMultipleFiles="true"
                               Hidden="false"
                               Disabled="_isUploading" />

            </MudPaper>

            @if (_uploads.Count > 0)
            {
                <MudPaper Class="pa-3" Outlined="true">

                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1">
                            Upload Progress
                        </MudText>

                        <MudChip T="string" Color="Color.Primary"
                                 Variant="Variant.Filled">
                            @_overallProgress.ToString("0")%
                        </MudChip>
                    </MudStack>

                    <MudProgressLinear Value="_overallProgress"
                                       Color="Color.Primary"
                                       Rounded="true"
                                       Class="mt-2 mb-4" />

                    <MudStack Spacing="2">

                        @foreach (var upload in _uploads)
                        {
                            <MudPaper Class="pa-3" Outlined="true">

                                <MudStack Spacing="1">

                                    <MudStack Row Justify="Justify.SpaceBetween">

                                        <MudText>
                                            @upload.FileName
                                        </MudText>

                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetProgressColor(upload)">
                                            @upload.StatusText
                                        </MudChip>

                                    </MudStack>

                                    <MudProgressLinear Value="@upload.Progress"
                                                       Rounded="true"
                                                       Color="@GetProgressColor(upload)" />

                                    <MudStack Row Justify="Justify.SpaceBetween">

                                        <MudText Typo="Typo.caption">
                                            @FormatHelper.Size(upload.UploadedBytes)
                                            /
                                            @FormatHelper.Size(upload.TotalBytes)
                                        </MudText>

                                        <MudText Typo="Typo.caption">
                                            @upload.Progress.ToString("0")%
                                        </MudText>

                                    </MudStack>

                                    @if (!string.IsNullOrWhiteSpace(upload.ErrorMessage))
                                    {
                                        <MudAlert Severity="Severity.Error"
                                                  Dense="true"
                                                  Variant="Variant.Text">
                                            @upload.ErrorMessage
                                        </MudAlert>
                                    }

                                </MudStack>

                            </MudPaper>
                        }

                    </MudStack>

                </MudPaper>
            }

        </MudStack>
    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Close"
                   Disabled="_isUploading"
                   Color="Color.Primary"
                   Variant="Variant.Filled">
            Close
        </MudButton>

    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _isUploading;
    private readonly List<UploadItem> _uploads = new();

    private double _overallProgress => _uploads.Count == 0 ? 0 : _uploads.Average(x => x.Progress);

    private async Task UploadFiles(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0) return;

        _isUploading = true;

        foreach (var file in files)
        {
            var item = new UploadItem
            {
                FileName = file.Name,
                TotalBytes = file.Size,
                Status = UploadStatus.Uploading,
                StatusText = "Uploading"
            };

            _uploads.Add(item);

            StateHasChanged();

            try
            {
                var progress = new Progress<long>(uploadedBytes =>
                {
                    item.UploadedBytes = uploadedBytes;

                    item.Progress =
                        item.TotalBytes == 0
                            ? 0
                            : (double)uploadedBytes / item.TotalBytes * 100;

                    InvokeAsync(StateHasChanged);
                });

                await FileUploadClient.UploadFileAsync(file, progress);

                item.UploadedBytes = item.TotalBytes;
                item.Progress = 100;
                item.Status = UploadStatus.Completed;
                item.StatusText = "Completed";
            }
            catch (Exception ex)
            {
                item.Status = UploadStatus.Failed;
                item.StatusText = "Failed";
                item.ErrorMessage = ex.Message;
            }

            StateHasChanged();
        }

        _isUploading = false;

        StateHasChanged();
    }

